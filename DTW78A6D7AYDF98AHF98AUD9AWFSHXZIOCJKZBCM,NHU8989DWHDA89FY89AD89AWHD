-- Load Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
getgenv().SecureMode = true -- Optional: Use Secure Mode

-- Create the main window
local Window = Rayfield:CreateWindow({
    Name = "Coldware",
    LoadingTitle = "Coldware",
    LoadingSubtitle = "made by inix",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "SCS",
        FileName = "SCS_Config"
    },
    Discord = {
        Enabled = false,
        Invite = "", -- optional
        RememberJoins = true
    },
    KeySystem = false -- optional, turn on if you want a key system
})

-- Main Tab
local MainTab = Window:CreateTab("Main Tab", 17079723134) -- icon asset id

-- Hitbox Button
MainTab:CreateButton({
    Name = "Hitbox",
    Callback = function()
        _G.HeadSize = 6
        _G.Disabled = true

        game:GetService('RunService').RenderStepped:Connect(function()
            if _G.Disabled then
                for _, player in ipairs(game:GetService('Players'):GetPlayers()) do
                    if player.Name ~= game:GetService('Players').LocalPlayer.Name then
                        pcall(function()
                            local character = player.Character
                            local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
                            if humanoidRootPart then
                                humanoidRootPart.Size = Vector3.new(_G.HeadSize, _G.HeadSize, _G.HeadSize)
                                humanoidRootPart.Transparency = 1
                                humanoidRootPart.BrickColor = BrickColor.new("Bright red")
                                humanoidRootPart.Material = Enum.Material.Neon
                                humanoidRootPart.CanCollide = false
                            end
                        end)
                    end
                end
            end
        end)
    end
})

-- ESP Button
MainTab:CreateButton({
    Name = "ESP",
    Callback = function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/8jke/zvz/refs/heads/main/Esp"))()
    end
})

-- Credits Tab
local CreditsTab = Window:CreateTab("Credits", 17079723134)

CreditsTab:CreateLabel("UI: Rayfield")
CreditsTab:CreateLabel("Made By: Inix.")
CreditsTab:CreateLabel("Made In October 1st, 2025")
CreditsTab:CreateLabel("Have Fun!")

